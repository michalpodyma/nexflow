# PostgreSQL
DB_USER=nexflow
DB_PASSWORD=nexflow_dev_password
DB_NAME=nexflow_db
DB_HOST=db
DB_PORT=5432

# Full async connection string (constructed from above in docker-compose)
DATABASE_URL=postgresql+asyncpg://nexflow:nexflow_dev_password@db:5432/nexflow_db

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application
APP_ENV=development
SECRET_KEY=change-me-in-production

# HubSpot (candidate pipeline)
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_RECEIVED=appointmentscheduled

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@nexflow.work

# Twilio (WhatsApp/SMS screening chatbot)
# ⚠️  WhatsApp Business API approval takes 1–2 weeks — apply NOW
# Account SID + Auth Token from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender number (E.164, without the "whatsapp:" prefix)
TWILIO_WHATSAPP_NUMBER=+14155238886
# Set to "true" to skip HMAC signature validation in local dev
TWILIO_SKIP_VALIDATION=true

# Upstash Redis (conversation state for screening chatbot)
# Provision via Vercel Marketplace → Upstash, then run: vercel env pull
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recruiter notification targets (screening results)
RECRUITER_EMAIL=rekruter@nexflow.work
RECRUITER_WHATSAPP_NUMBER=+48XXXXXXXXX

# OLX Business API (job board posting)
# Obtain at https://developer.olx.pl — create an app under "Partner API"
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=

# Pracuj.pl XML feed (job board posting)
# URL provided by Pracuj.pl Employer Portal — leave empty to skip Pracuj.pl
PRACUJ_XML_FEED_URL=
