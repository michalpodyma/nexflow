# PostgreSQL
DB_USER=nexflow
DB_PASSWORD=nexflow_dev_password
DB_NAME=nexflow_db
DB_HOST=db
DB_PORT=5432

# Full async connection string (constructed from above in docker-compose)
DATABASE_URL=postgresql+asyncpg://nexflow:nexflow_dev_password@db:5432/nexflow_db

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application
APP_ENV=development
SECRET_KEY=change-me-in-production
